+
+bool Actor::canSee(const Actor *other, Sight &sight) const {
+	if (g_grim->getGameType() != GType_GRIM || _setName.empty() || other->_setName != _setName)
+		return false;
+
+	if (sight.state == 0) {
+		sight.state = 2;
+		Costume *costume = getCurrentCostume();
+		if (!costume)
+			return false;
+		int joint = costume->getHeadFirstJoint();
+		if (joint < 0 || !costume->getModelNodes())
+			return false;
+
+		ModelNode *node = costume->getModelNodes() + joint;
+		node->_needsUpdate = true;
+		ModelNode *root = node;
+		while (root->_parent) {
+			root = root->_parent;
+			root->_needsUpdate = true;
+		}
+
+		Math::Matrix4 matrix;
+		matrix.setPosition(_pos);
+		matrix.buildFromEuler(_yaw, _pitch, _roll, Math::EO_ZXY);
+		root->setMatrix(matrix);
+		root->update();
+
+		sight.head = node->_pivotMatrix.getPosition();
+		// The original takes the second axis of the orientation matrix of the actor (so a pitched actor sees less in front of
+		// it: the x and y of the axis are scaled by the cosine of the pitch) and the test is on x and y only
+		sight.forward = getSimplePuckVector();
+		sight.pitchScale = _pitch.getCosine();
+		sight.cosLimit = cosf(fabsf(costume->getHeadMaxRoll()) * 0.5f * (float)M_PI / 180.0f);
+		sight.state = 1;
+	}
+	if (sight.state != 1)
+		return false;
+
+	Math::Vector3d delta = other->_pos - sight.head;
+	Math::Vector3d direction(delta.x(), delta.y(), 0.0f);
+	direction.normalize();
+	float dot = sight.pitchScale * (sight.forward.x() * direction.x() + sight.forward.y() * direction.y());
+	return dot >= sight.cosLimit;
+}
