+					const Math::Vector3d &vert = sector->getVertices()[v];
+					uint e = 0;
+					while (e < shifts.size() && !(shifts[e].key[0] == vert.x() && shifts[e].key[1] == vert.y() && shifts[e].key[2] == vert.z()))
