+	Common::String out = lua_isstring(r) ? lua_getstring(r) : "";
+	if (status != 0)
+		out += " (error)";
+	Common::String tmp = Common::String(dir) + "/cmd.tmp";
+	FILE *f = fopen(tmp.c_str(), "wb");
+	if (f) {
+		fputs(out.c_str(), f);
+		fclose(f);
+		rename(tmp.c_str(), (Common::String(dir) + "/cmd.out").c_str());
