+void GrimEngine::drawFrameMarker() {
+	const int cell = 8;
+	for (int i = 0; i < 34; i++) {
+		bool on = i == 0 ? true : i == 1 ? false : ((_simFrame >> (33 - i)) & 1) != 0;
+		byte v = on ? 255 : 0;
+		PrimitiveObject p;
+		p.createRectangle(Common::Point(i * cell, 480 - cell), Common::Point(i * cell + cell - 1, 479), Color(v, v, v), true);
+		g_driver->drawRectangle(&p);
+	}
