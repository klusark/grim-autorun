+						fresh.key[0] = vert.x();
+						fresh.key[1] = vert.y();
+						fresh.key[2] = vert.z();
+						fresh.sum[0] = fresh.sum[1] = fresh.sum[2] = 0.f;
+						fresh.count = 0;
+						shifts.push_back(fresh);
+					}
+					for (int c = 0; c < 3; c++)
