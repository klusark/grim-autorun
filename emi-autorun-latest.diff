+	s->grimSetFree(false);
+	Sector *next;
+	if (planDist2(exitPt, p) <= 0.0001f)
+		next = nullptr;
+	else
+		next = planFind(exitPt);
+	if (next) {
+		if (planDfs(exitPt, dest, next))
+			return true;
+		next->grimSetFree(false);
+	}
+	float cand[32 * 4];
+	const int count = planNeighbours(s, dest, cand);
+	for (int i = 0; i < count; i++) {
