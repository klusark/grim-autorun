+		m[r * 3 + 1] = toF((LD)p[4] * q[1] + (LD)p[1] * q[0] + (LD)p[7] * q[2]);
+		m[r * 3 + 2] = toF((LD)p[8] * q[2] + (LD)p[2] * q[0] + (LD)p[5] * q[1]);
