+Sector *Set::findPointSectorEMI(const Math::Vector3d &p, Sector::SectorType type, const Common::Array<const Sector *> &skip) {
+	for (int i = 0; i < _numSectors; i++) {
+		Sector *sector = _sectors[i];
+		if (!sector || !(sector->getType() & type) || !sector->isVisible() || !sector->containsPointEMI(p))
+			continue;
+		if (Common::find(skip.begin(), skip.end(), sector) == skip.end())
+			return sector;
+	}
+	return nullptr;
+}
