+float Sector::getPlaneYEMI(const Math::Vector3d &point) const {
+	if (_normal.y() == 0.f)
+		return _vertices[0].y();
+	return point.y() - distanceToPoint(point) / _normal.y();
+}
+
+float Sector::getExitEMI(const Math::Vector3d &start, const Math::Vector3d &end, Math::Vector3d *exitPoint) const {
+	const float sx = start.x();
+	const float sz = start.z();
+	const float dx = (float)((double)end.x() - sx);
+	const float dz = (float)((double)end.z() - sz);
+	const double stepLength = sqrt((double)dx * dx + (double)dz * dz);
+	float bestT = -1.f;
+	float angle = 0.f;
+	for (int i = 0; i < _numVertices; i++) {
+		int prev = i - 1;
+		if (prev < 0)
+			prev = _numVertices - 1;
+		const Math::Vector3d &a = _vertices[i];
+		const Math::Vector3d &b = _vertices[prev];
+		const double ex = (double)b.x() - a.x();
+		const double ez = (double)b.z() - a.z();
+		const float denom = (float)(dx * ez - ex * dz);
+		if (denom == 0.f)
+			continue;
+		const float ax = (float)((double)sx - a.x());
+		const float az = (float)((double)sz - a.z());
+		const float t = (float)((az * ex - ax * ez) / denom);
+		if (!(t >= 0.f && t <= 1.f))
+			continue;
+		const double u = (az * (double)dx - ax * (double)dz) / denom;
+		if (!(u >= 0.0 && u <= 1.0))
+			continue;
+		if (t <= bestT) {
+			if (t == 0.f)
+				angle = 0.f;
+			continue;
+		}
+		bestT = t;
+		const double edgeLength = sqrt(ex * ex + ez * ez);
+		const double cosine = dx / stepLength * (ex / edgeLength) + dz / stepLength * (ez / edgeLength);
+		angle = Math::rad2deg<float>(acos(CLIP(cosine, -1.0, 1.0)));
+	}
+	*exitPoint = start;
+	if (bestT > 0.f) {
+		exitPoint->x() = (float)((double)dx * bestT + sx);
+		exitPoint->z() = (float)((double)dz * bestT + sz);
+	}
+	exitPoint->y() = getPlaneYEMI(*exitPoint);
+	if (bestT <= 0.f)
+		return angle;
+	if (angle <= 90.f)
+		return (float)(angle + 0.1);
+	return (float)-(180.2 - angle);
+}
+
+bool Sector::containsPointEMI(const Math::Vector3d &point) const {
+	const float defaultHeight = 0.005f;
+	const float slack = 1e-5f;
+	float height = _height;
+	if (height == 0.f)
+		height = defaultHeight;
+	if (_normal.y() == 0.f)
+		return false;
+	if (fabsf(distanceToPoint(point) / _normal.y()) > height)
+		return false;
+
+	for (int i = 0; i < _numVertices; i++) {
+		Math::Vector3d edge = _vertices[i] - _vertices[i + 1];
+		Math::Vector3d delta = _vertices[i + 1] - point;
+		edge.y() = 0;
+		delta.y() = 0;
+		float side = Math::Vector3d::crossProduct(delta, edge).y() / edge.getSquareMagnitude();
+		if (side < -slack)
+			return false;
+	}
+	return true;
+}
