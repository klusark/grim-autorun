+void Actor::walkForwardEMI(float dist) {
+	const int maxHandovers = 8;
+	const float minMove = 0.0001f;
+	Set *set = g_grim->getCurrSet();
+	bool backwards = false;
+	if (dist < 0) {
+		dist = -dist;
+		backwards = true;
+	}
+	Sector *sector = getEMIWalkSector(set);
+	Common::Array<const Sector *> off;
+
+	for (int depth = 0; dist > 0.f; depth++) {
+		Math::Vector3d heading(_moveYaw.getSine(), 0.f, _moveYaw.getCosine());
+		if (backwards)
+			heading = -heading;
+		if (!sector) {
+			moveTo(_pos + heading * dist);
+			_walkedCur = true;
+			break;
+		}
+
+		Math::Vector3d ahead = _pos + heading;
+		ahead.y() = sector->getPlaneYEMI(ahead);
+		Math::Vector3d dir = ahead - _pos;
+		dir.normalize();
+		Math::Vector3d end = _pos + dir * dist;
+		if (sector->isVisible() && sector->containsPointEMI(end)) {
+			end.y() = sector->getPlaneYEMI(end);
+			moveTo(end);
+			_walkedCur = true;
+			break;
+		}
+		if (depth >= maxHandovers)
+			break;
+
+		Math::Vector3d exitPoint;
+		float turn = sector->getExitEMI(_pos, end, &exitPoint);
+		Math::Vector3d toExit = exitPoint - _pos;
+		if (toExit.getMagnitude() > minMove)
+			_walkedCur = true;
+		dist -= toExit.dotProduct(heading);
+		_pos = exitPoint;
+
+		off.push_back(sector);
+		Sector *next = set->findPointSectorEMI(exitPoint, Sector::WalkType, off);
+		if (next) {
+			sector = next;
+			continue;
+		}
+		off.pop_back();
+		if (turn != 0.f)
+			turnTo(0, _moveYaw.getDegrees() + turn, 0, true);
+	}
+	_emiWalkSector = sector;
+	_emiWalkSet = set;
+	_emiWalkPos = _pos;
+}
