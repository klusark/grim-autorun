+Sector *Actor::getEMIWalkSector(Set *set) {
+	const float samePlace = 0.0001f;
+	if (!set)
+		return nullptr;
+	if (_emiWalkSector && _emiWalkSet == set && (_pos - _emiWalkPos).getMagnitude() < samePlace) {
+		for (int i = 0; i < set->getSectorCount(); i++) {
+			if (set->getSectorBase(i) == _emiWalkSector)
+				return _emiWalkSector;
+		}
+	}
+	Sector *sector = set->findPointSectorEMI(_pos, Sector::WalkType, Common::Array<const Sector *>());
+	if (!sector)
+		set->findClosestSector(_pos, &sector, &_pos);
+	_emiWalkSector = sector;
+	_emiWalkSet = set;
+	_emiWalkPos = _pos;
+	return sector;
+}
