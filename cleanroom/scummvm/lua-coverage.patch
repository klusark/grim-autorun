+ * the Free Software Foundation, either version 3 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <http://www.gnu.org/licenses/>.
+ *
+ */
+
+#define FORBIDDEN_SYMBOL_EXCEPTION_getenv
+
+#include "common/array.h"
+#include "common/config-manager.h"
+#include "common/file.h"
+#include "common/fs.h"
+#include "common/hashmap.h"
+#include "common/str.h"
+#include "common/system.h"
+
+#include "engines/grim/lua/lcoverage.h"
+#include "engines/grim/lua/lopcodes.h"
+#include "engines/grim/lua/lstring.h"
+
+namespace Grim {
+
+bool luaCovEnabled = false;
+TProtoFunc *luaCovLastTf = nullptr;
+uint32 *luaCovLastHits = nullptr;
+
+namespace {
+
+// One function: what it is (the same function made again, by another dofile of its file or a restore, adds to the same one)
+struct CovRec {
+	Common::String key;            // file, line, code and constants: what makes it the same function
+	Common::String file;
+	int32 line;
+	Common::Array<byte> code;      // up to and with its ENDCODE
+	Common::Array<Common::String> consts;   // "S <text>", "N <number>", "P <record>", "-"
+	Common::Array<uint32> hits;    // by offset in code: how many times the instruction there ran
+	bool hit;                      // any count since the last write
+};
+
+struct PtrHash {
+	uint operator()(const void *p) const { return (uint)(((uintptr)p) >> 3) ^ (uint)(((uintptr)p) >> 19); }
+};
+struct PtrEq {
+	bool operator()(const void *a, const void *b) const { return a == b; }
+};
+
+Common::String g_dir;
+Common::Array<CovRec *> g_recs;
+Common::HashMap<Common::String, uint> g_byKey;
+Common::HashMap<const void *, uint, PtrHash, PtrEq> g_live;
+uint32 g_dumps = 0;
+
+// The length in bytes of each instruction (lua31dis.py has the same table)
+int opSize(byte op) {
+	switch (op) {
+	case SETLISTW:
+		return 4;
+	case SETLIST:
+	case CALLFUNC:
+	case PUSHNUMBERW: case PUSHCONSTANTW: case GETGLOBALW: case GETDOTTEDW: case PUSHSELFW: case CREATEARRAYW:
+	case SETGLOBALW: case ONTJMPW: case ONFJMPW: case JMPW: case IFFJMPW: case IFTUPJMPW: case IFFUPJMPW: case SETLINEW:
+		return 3;
+	case PUSHNIL: case PUSHNUMBER: case PUSHCONSTANT: case PUSHUPVALUE: case PUSHLOCAL: case GETGLOBAL: case GETDOTTED:
+	case PUSHSELF: case CREATEARRAY: case SETLOCAL: case SETGLOBAL: case SETTABLE: case SETLIST0: case SETMAP: case ONTJMP:
+	case ONFJMP: case JMP: case IFFJMP: case IFTUPJMP: case IFFUPJMP: case CLOSURE: case CALLFUNC0: case CALLFUNC1: case RETCODE:
+	case SETLINE: case POP:
+		return 2;
+	default:
+		return 1;
+	}
+}
+
+int32 codeLength(const byte *code) {
+	int32 p = 2;   // (the stack size and the arguments)
+	while (code[p] != ENDCODE)
+		p += opSize(code[p]);
+	return p + 1;
+}
+
+Common::String escape(const char *s) {
+	Common::String r;
+	for (; *s; s++) {
+		byte c = (byte)*s;
+		if (c == '\\')
+			r += "\\\\";
+		else if (c < 32 || c >= 127)
+			r += Common::String::format("\\x%02x", c);
+		else
+			r += (char)c;
+	}
+	return r;
+}
+
+uint record(TProtoFunc *tf) {
+	if (g_live.contains(tf))
+		return g_live[tf];
+	CovRec *r = new CovRec();
+	r->file = tf->fileName ? tf->fileName->str : "?";
+	r->line = tf->lineDefined;
+	int32 n = codeLength(tf->code);
+	r->code.resize(n);
+	memcpy(r->code.data(), tf->code, n);
+	for (int32 i = 0; i < tf->nconsts; i++) {
+		TObject *o = tf->consts + i;
+		if (ttype(o) == LUA_T_STRING)
+			r->consts.push_back("S " + escape(svalue(o)));
+		else if (ttype(o) == LUA_T_NUMBER)
+			r->consts.push_back(Common::String::format("N %.9g", (double)nvalue(o)));
+		else if (ttype(o) == LUA_T_PROTO && tfvalue(o))
+			r->consts.push_back(Common::String::format("P %u", record(tfvalue(o))));
+		else
+			r->consts.push_back("-");
+	}
+	r->key = Common::String::format("%s\n%d\n", r->file.c_str(), r->line);
+	for (int32 i = 0; i < n; i++)
+		r->key += Common::String::format("%02x", r->code[i]);
+	for (uint i = 0; i < r->consts.size(); i++)
+		r->key += "\n" + r->consts[i];
+	uint idx;
+	if (g_byKey.contains(r->key)) {
+		idx = g_byKey[r->key];
+		delete r;
+	} else {
+		r->hits.resize(n);
+		for (int32 i = 0; i < n; i++)
+			r->hits[i] = 0;
+		r->hit = false;
+		idx = g_recs.size();
+		g_recs.push_back(r);
+		g_byKey[r->key] = idx;
+	}
+	g_live[tf] = idx;
+	return idx;
+}
+
+} // end of anonymous namespace
+
+void luaCov_init() {
+	if (luaCovEnabled)
+		return;
+	if (ConfMan.hasKey("lua_coverage"))
+		g_dir = ConfMan.get("lua_coverage");
+	if (g_dir.empty()) {
+		const char *e = getenv("GRIM_LUA_COVERAGE");
+		if (e)
+			g_dir = e;
+	}
+	luaCovEnabled = !g_dir.empty();
+}
+
+void luaCov_register(TProtoFunc *tf) {
+	if (luaCovEnabled && tf)
+		record(tf);
+}
+
+void luaCov_switch(TProtoFunc *tf) {
+	CovRec *r = g_recs[record(tf)];
+	r->hit = true;
+	luaCovLastTf = tf;
+	luaCovLastHits = r->hits.data();
+}
+
+void luaCov_free(TProtoFunc *tf) {
+	if (!luaCovEnabled)
+		return;
+	g_live.erase(tf);
+	if (luaCovLastTf == tf) {
+		luaCovLastTf = nullptr;
+		luaCovLastHits = nullptr;
+	}
+}
+
+void luaCov_dump() {
+	if (!luaCovEnabled || g_recs.empty())
+		return;
+	Common::DumpFile f;
+	Common::FSNode dir(Common::Path(g_dir, Common::Path::kNativeSeparator));
+	// (a name of its own: the runs of several engines at once write to the same folder)
+	Common::FSNode node;
+	uint32 salt = g_system->getMillis() ^ (uint32)(uintptr)&f ^ (uint32)((uintptr)&g_recs >> 12);
+	for (uint32 i = 0; ; i++) {
+		node = dir.getChild(Common::String::format("luacov_%08x_%u_%u.txt", salt, g_dumps, i));
+		if (!node.exists())
+			break;
+	}
+	g_dumps++;
+	if (!f.open(node)) {
+		warning("Lua coverage: cannot write %s", node.getPath().toString().c_str());
+		return;
+	}
+	f.writeString("LUACOV 1\n");
+	// (every function: the ones that never ran too, but the counts only of those that ran since the last write)
+	for (uint idx = 0; idx < g_recs.size(); idx++) {
+		CovRec *r = g_recs[idx];
+		Common::String s = Common::String::format("F %u %d %s\n", idx, r->line, escape(r->file.c_str()).c_str());
+		s += "C ";
+		for (uint i = 0; i < r->code.size(); i++)
+			s += Common::String::format("%02x", r->code[i]);
+		s += "\n";
+		for (uint i = 0; i < r->consts.size(); i++)
+			s += Common::String::format("K %u %s\n", i, r->consts[i].c_str());
+		if (r->hit) {
+			s += "H";
+			for (uint i = 0; i < r->hits.size(); i++) {
+				if (r->hits[i]) {
+					s += Common::String::format(" %u:%u", i, r->hits[i]);
+					r->hits[i] = 0;
+				}
+			}
+			s += "\n";
+			r->hit = false;
+		}
+		f.writeString(s);
+	}
+	f.writeString("END\n");
+	f.close();
+	// (the counts are zero again: the next luaCov_switch sets hit again)
+	luaCovLastTf = nullptr;
+	luaCovLastHits = nullptr;
+}
+
+void luaCov_shutdown() {
+	luaCov_dump();
+	for (uint i = 0; i < g_recs.size(); i++)
+		delete g_recs[i];
+	g_recs.clear();
+	g_byKey.clear();
+	g_live.clear();
+	luaCovLastTf = nullptr;
+	luaCovLastHits = nullptr;
+	luaCovEnabled = false;
+	g_dir.clear();
+}
+
+} // end of namespace Grim
