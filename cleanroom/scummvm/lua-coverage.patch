+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <http://www.gnu.org/licenses/>.
+ *
+ */
+
+#ifndef GRIM_LCOVERAGE_H
+#define GRIM_LCOVERAGE_H
+
+#include "engines/grim/lua/lobject.h"
+
+namespace Grim {
+
+/*
+** Coverage of the Lua scripts: how many times each instruction of each Lua function ran.
+**
+** On when the configuration key lua_coverage (or the environment variable GRIM_LUA_COVERAGE) names a folder. Every function
+** that is made (parsed, undumped or restored from a save) is recorded with its file, line, code and constants, also the ones
+** that never run; the counts are written to <folder>/luacov_<n>.txt when the engine ends and when a script asks
+** (PrintDebug("CRLUACOV"), or "CRGCOV"), and are zero again after each write, so the files of a run add up.
+**
+** The parser marks the line of each statement in the code of text scripts with SETLINEW (line | LUACOV_LINE): the marks move
+** with the code when the parser moves it (jumps made shorter or longer, the condition of a while), and the VM skips them, so
+** the stack and the behaviour are the same as without (a real SETLINE, of $debug, puts a line slot on the stack).
+** autorun/tools/luacov.py reads the files.
+*/
+
+#define LUACOV_LINE 0x8000
+
+extern bool luaCovEnabled;
+extern TProtoFunc *luaCovLastTf;
+extern uint32 *luaCovLastHits;
+
+void luaCov_init();
+void luaCov_register(TProtoFunc *tf);
+void luaCov_switch(TProtoFunc *tf);
+void luaCov_free(TProtoFunc *tf);
+void luaCov_dump();
+void luaCov_shutdown();
+
+inline void luaCov_hit(TProtoFunc *tf, const byte *pc) {
+	if (tf != luaCovLastTf)
+		luaCov_switch(tf);
+	luaCovLastHits[pc - tf->code]++;
+}
+
+} // end of namespace Grim
+
+#endif
